# Live data providers
# Aviationstack free tier: add your key to enable real flight status/search.
AVIATIONSTACK_API_KEY=
# OpenSky airspace data is enabled by default and does not require a key for basic access.
OPEN_SKY_ENABLED=1
# Open-Meteo weather is enabled by default and does not require a key for non-commercial use.
OPEN_METEO_ENABLED=1

# Real-time refresh. Keep this at 60s or higher on free tiers to avoid quota exhaustion.
REFRESH_SECONDS=60

# Set to 1 only when serving behind HTTPS.
COOKIE_SECURE=0
